# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate each secret with:  openssl rand -base64 32

# The server's address. A domain you own, or <server-ip>.sslip.io for free (e.g. 203.0.113.7.sslip.io).
DOMAIN=
# The shop's ID in the database (letters, digits and dashes).
BUSINESS_ID=

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Signs the 24-hour offline permission on each phone. Make the pair with
# `node scripts/make-offline-keys.mjs`: the private key goes here, the public key
# (OFFLINE_VERIFY_KEY) on the shop gateway, which can check permissions but not make them.
OFFLINE_SIGNING_KEY=
# Shared with the shop gateway so it can report its health and send sale backups.
GATEWAY_TOKEN=

# Reading supplier bills (OpenRouter) and spoken sales (OpenAI speech to text).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
INVOICE_MONTHLY_LIMIT=100
VOICE_MONTHLY_LIMIT=3000

# Phone notifications (optional). APNS_KEY is the Apple .p8 key as base64; FCM_SERVICE_ACCOUNT is
# the Firebase service-account JSON as base64.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.counterwell.mobile
FCM_SERVICE_ACCOUNT=
