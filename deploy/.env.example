# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate each secret with:  openssl rand -base64 32

# The server's address. A domain you own, or <server-ip>.sslip.io for free (e.g. 203.0.113.7.sslip.io).
DOMAIN=
# The shop's ID in the database (letters, digits and dashes).
BUSINESS_ID=

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Signs the 24-hour offline permission on each phone; the shop gateway uses the same value.
OFFLINE_SIGNING_SECRET=
# Shared with the shop gateway so it can report its health and send sale backups.
GATEWAY_TOKEN=

# Reading supplier bills (OpenRouter) and spoken sales (OpenAI speech to text).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
INVOICE_MONTHLY_LIMIT=100
VOICE_MONTHLY_LIMIT=3000
