DATABASE_URL=postgres://counterwell:counterwell_local@localhost:50489/counterwell
PORT=4100
BETTER_AUTH_URL=http://localhost:4100
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:8081,counterwell://
OFFLINE_SIGNING_SECRET=replace-with-a-different-32-character-secret
GATEWAY_TOKEN=replace-with-a-third-32-character-secret
BUSINESS_ID=pilot-pharmacy
GATEWAY_PORT=4101
GATEWAY_DATA_DIR=.data/gateway
CAMERA_CLIP_DIR=.data/gateway/clips
PRINTER_HOST=
SARVAM_API_KEY=
GEMINI_API_KEY=
# Used only when GEMINI_API_KEY is empty: the same Gemini models through OpenRouter (google/<model>).
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
UPLOAD_DIR=.data/uploads
NODE_ENV=development
# Per-feature overrides; no automatic upgrade to a more expensive model.
INVOICE_MODEL=gemini-2.5-flash-lite
STRUCTURE_MODEL=gemini-2.5-flash-lite
# Per business / India calendar month. Zero disables new jobs; cache hits still work.
INVOICE_MONTHLY_LIMIT=100
VOICE_MONTHLY_LIMIT=3000
# Conservative audio reservation: 60 seconds per new recording (two 30s attempts).
VOICE_MONTHLY_RESERVED_SECONDS=18000
