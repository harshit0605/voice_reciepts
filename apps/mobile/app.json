{
  "expo": {
    "name": "Counterwell",
    "slug": "counterwell",
    "scheme": "counterwell",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.counterwell.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your shop printer and backup gateway."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.counterwell.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#146D5A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Counterwell"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan product barcodes and photograph supplier bills."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record the sale items you choose to dictate."
        }
      ],
      "expo-font",
      "expo-localization",
      "./plugins/release"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
